# Web Push (server-side only — set these as secrets in your hosting provider).
# Generate a pair with: node scripts/generate-vapid-keys.mjs
# Use DIFFERENT keys for development and production. Never commit real values.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:you@example.com or https://your-site
VAPID_SUBJECT=mailto:replace-me@example.com
# Bearer token required by POST /api/push/send (32+ random characters).
PUSH_ADMIN_TOKEN=
