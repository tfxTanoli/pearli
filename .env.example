# Copy to .env for local development. All values are server-side only (no VITE_
# prefix), so none are exposed to the browser. Never commit real values.
# Production values are set as environment variables in Vercel.

# Stripe — use TEST keys (sk_test_...) until going live.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint .../api/stripe/webhook (whsec_...).
# For local testing, `stripe listen` prints its own whsec_ to use instead.
STRIPE_WEBHOOK_SECRET=

# Supabase — project URL and SECRET key (sb_secret_...). The secret key bypasses
# row-level security, so it must never be used in browser code.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Web Push. Generate with: node scripts/generate-vapid-keys.mjs
# Use DIFFERENT keys for development and production.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: address or the site's https URL.
VAPID_SUBJECT=
# Bearer token required by POST /api/push/send (32+ random characters).
PUSH_ADMIN_TOKEN=
